{
  "name": "certimotors-api",
  "version": "1.0.0",
  "description": "CERTIMOTORS - Plataforma de Certificación de Autos con Claude IA + WhatsApp + Telegram",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
  "start": "node src/index.js",
  "dev": "node --watch src/index.js",
  "lint": "eslint src/ --fix",
  "format": "prettier --write .",
  "test": "echo 'Testing CERTIMOTORS' && bash tests/curl-commands.sh"
},
  "keywords": [
    "BNPL",
    "certimotors",
    "whatsapp",
    "telegram",
    "claude-ai"
  ],
  "author": "Rodrigo Galindo",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3"
  }
}
